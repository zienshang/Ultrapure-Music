# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit it.

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=UltrapureMusic
DEBUG=true
# Generate a strong random secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret
ALLOWED_ORIGINS=*

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/ultrapure.db

# ── Google OAuth (for backend sign-in) ───────────────────────────────────────
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add http://localhost:8000/api/v1/auth/google/callback as an Authorized redirect URI
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── YouTube Data API v3 ───────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create an API key and restrict it to YouTube Data API v3
YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_V3_KEY

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_MAX_AGE_HOURS=24
CACHE_CLEANUP_INTERVAL_HOURS=6

# ── Sync ──────────────────────────────────────────────────────────────────────
SYNC_INTERVAL_HOURS=12
