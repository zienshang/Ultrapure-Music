## Copy this file to local.properties and fill in your values.
## local.properties is gitignored — never commit it.

# Android SDK location (set automatically by Android Studio)
sdk.dir=/path/to/your/Android/Sdk

# ── Developer-local secrets ──────────────────────────────────────────────────
# YouTube Data API v3 key
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create an API key and restrict it to YouTube Data API v3
# 3. Paste it below
youtubeApiKey=YOUR_YOUTUBE_DATA_API_V3_KEY
